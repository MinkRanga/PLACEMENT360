# Backend Environment Variables
PROJECT_NAME="PLACEMENT360"
ENVIRONMENT="development"
DEBUG=True

BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

SECRET_KEY="generate-a-strong-secret-key-for-jwt-tokens"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL="postgresql://postgres:your-db-password@db.your-supabase-ref.supabase.co:5432/postgres"

SUPABASE_URL="https://your-supabase-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
