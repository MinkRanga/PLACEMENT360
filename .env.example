# ==============================================================================
# PLACEMENT360 - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env in backend/ or root and fill in your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
PROJECT_NAME="PLACEMENT360"
ENVIRONMENT="development"
DEBUG=True

# CORS - Allowed frontend origins (JSON list format)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# JWT Authentication
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="generate-a-strong-secret-key-for-jwt-tokens"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Supabase PostgreSQL / SQLAlchemy)
# Supabase connection URI format:
# postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Direct connection URI format:
# postgresql://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:your-db-password@db.your-supabase-ref.supabase.co:5432/postgres"

# Optional Supabase API Credentials
SUPABASE_URL="https://your-supabase-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"
VITE_APP_NAME="PLACEMENT360"
